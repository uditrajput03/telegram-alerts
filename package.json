{
  "name": "telegram-alerts",
  "version": "1.0.0",
  "description": "Serverless notification gateway on Cloudflare Workers & Hono. Dispatches webhooks & alerts to auto-created Telegram forum topics with zero server costs.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typegen": "wrangler types",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "cloudflare-workers",
    "telegram",
    "telegram-bot",
    "telegram-notifications",
    "alerts",
    "alerting",
    "notification-service",
    "webhook",
    "webhooks",
    "serverless",
    "hono",
    "typescript",
    "monitoring",
    "devops",
    "forum-topics"
  ],
  "author": "Udit Rajput",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/uditrajput03/telegram-alerts.git"
  },
  "homepage": "https://github.com/uditrajput03/telegram-alerts#readme",
  "bugs": {
    "url": "https://github.com/uditrajput03/telegram-alerts/issues"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.7",
    "wrangler": "^3.114.0"
  }
}
